# Copy to .env.local and fill in. NEVER commit .env.local.
# With no keys at all the app still runs: the five hand-built worlds play, and every model step is labelled as a sample.

# Absolute origin for share-card URLs. Optional: Vercel fills this from VERCEL_URL when unset.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# Muse Spark Open (Meta open weights) on Baseten: scientist, designer, judge, Ada, citizens.
OPEN_WEIGHTS_PROVIDER=baseten   # baseten | fireworks
BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1   # model: meta-models/muse-spark-open-1026
# FIREWORKS_API_KEY=

# Meta Model API (https://dev.meta.ai): Muse Image + SAM 3.1 for the art, Muse Voice Transcribe for speech.
MODEL_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1

# Keep the scientist and designer on Muse Spark Open even when a Meta key is set (spends Meta credit on art only).
# Leave unset to route them to Muse Spark 1.3 / Muse Wonder 1.0 on the Meta Model API.
REASONING_BACKEND=open-weights

# Hard spend caps. Every model call is refused once a provider's ledger (.spend/ledger.json) reaches its cap.
SPEND_CAP_META_USD=5
SPEND_CAP_BASETEN_USD=5
