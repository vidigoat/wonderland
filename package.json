{
  "name": "wonderland",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-meta.ts",
    "spike": "tsx --conditions=react-server --env-file=.env.local scripts/spike-generate.ts",
    "eval": "tsx --conditions=react-server --env-file=.env.local scripts/eval-generate.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "lab": "tsx --conditions=react-server --env-file=.env.local scripts/eval-generate.ts --lab",
    "verify-worlds": "tsx --conditions=react-server scripts/verify-worlds.mts",
    "paint": "tsx --conditions=react-server --env-file=.env.local scripts/paint-world.mts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "pixi.js": "^8.22.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.15.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.21.0"
}
