# Copy to .env.local and fill in. NEVER commit .env.local.

# Absolute origin for share-card URLs. Optional: Vercel fills this from VERCEL_URL when unset.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example

# Meta Model API — https://dev.meta.ai (card required even for the $150 hackathon credits)
MODEL_API_KEY=
# META_BASE_URL=https://api.meta.ai/v1

# Open weights for the AI rival + citizens (needed for the $10K Best Open Weights prize)
OPEN_WEIGHTS_PROVIDER=fireworks   # fireworks | baseten
FIREWORKS_API_KEY=
# FIREWORKS_GLIMMER_MODEL=accounts/fireworks/models/muse-glimmer-30b   # verify exact id on fireworks.ai
BASETEN_API_KEY=
# BASETEN_BASE_URL=https://inference.baseten.co/v1   # model: meta-models/muse-spark-open-1026 (NOT muse-spark-open)
